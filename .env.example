# ホスト側の公開ポート
COMFYUI_PORT=8188

# ホスト側の bind アドレス。既定はループバックのみで、同じマシンからしか
# 繋がらない。LAN の他マシンから使いたい場合のみ 0.0.0.0 などに広げる
# (ComfyUI-Manager からカスタムノードを入れられる状態になる点に注意)
COMFYUI_BIND=127.0.0.1

# 取得する ComfyUI のリビジョン (master / v0.3.x などのタグ)
COMFYUI_VERSION=master

# コンテナの実行ユーザー。生成物の所有者をホストの自分に合わせるため
# `id -u` / `id -g` の値を指定する
COMFYUI_UID=1000
COMFYUI_GID=1000

# ComfyUI-Manager を有効にするか (1 で有効)。Manager の起動に失敗して
# ComfyUI ごと立ち上がらなくなった場合は 0 にして退避できる
COMFYUI_ENABLE_MANAGER=1
